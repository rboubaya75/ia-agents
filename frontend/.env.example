# Frontend configuration template for the secure V1 architecture.
# Copy this file to frontend/.env.local for local development.
#
# Ces valeurs sont injectées au build par Vite (V2-LLD-010 §15.1). Ce qui peut changer
# sans reconstruction — marge de renouvellement du jeton, borne d'inactivité du flux — est
# lu à l'exécution depuis public/config.json et n'a pas sa place ici.

VITE_COGNITO_USER_POOL_ID=replace-me
VITE_COGNITO_CLIENT_ID=replace-me
VITE_COGNITO_REGION=eu-west-3

# Origine de l'API. Le chemin V2 y appelle /api/v1/conversations/{id}/messages.
VITE_API_BASE_URL=replace-me
